// Cloudflare deployment: the static Angular build plus one Worker that proxies CORE.
// The API key is a Worker secret (`npx wrangler secret put CORE_API_KEY`), never in this file.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "mini-cypris",
  "main": "worker/core-proxy.js",
  "compatibility_date": "2026-06-01",
  "assets": {
    "directory": "dist/mini-cypris/browser",
    "binding": "ASSETS",
    // Unknown paths load index.html so the Angular router can handle them.
    "not_found_handling": "single-page-application",
    // Only API calls reach the Worker; the app's files are served directly.
    "run_worker_first": ["/core-api/*"],
  },
}
