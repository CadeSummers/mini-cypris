// Cloudflare deployment: the static Angular build plus one Worker that proxies CORE.
// The API key is a Worker secret (`npx wrangler secret put CORE_API_KEY`), never in this file.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "mini-cypris",
  "main": "worker/core-proxy.js",
  "compatibility_date": "2026-06-01",
  // Per-visitor cap on requests that reach CORE: one small Durable Object per
  // visitor keeps an exact count (see VisitorLimiter in worker/core-proxy.js).
  "durable_objects": {
    "bindings": [{ "name": "VISITOR_LIMITER", "class_name": "VisitorLimiter" }],
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["VisitorLimiter"] }],
  // The model behind plain-English search (see worker/ai-query.js). Workers AI
  // needs no key: the Worker reaches it through this binding.
  "ai": { "binding": "AI" },
  "assets": {
    "directory": "dist/mini-cypris/browser",
    "binding": "ASSETS",
    // Unknown paths load index.html so the Angular router can handle them.
    "not_found_handling": "single-page-application",
    // Only API calls reach the Worker; the app's files are served directly.
    "run_worker_first": ["/core-api/*", "/ai/*", "/metrics", "/metrics/*"],
  },
}
